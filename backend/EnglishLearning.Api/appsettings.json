{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=english_learning_db;Username=postgres;Password=12345678"
  },
  "Jwt": {
    "Secret": "EnglishLearningAI_DevelopmentSecretKey_MustBeAtLeast32BytesLong_2026!",
    "Issuer": "EnglishLearningAI",
    "Audience": "EnglishLearningClient",
    "ExpiryMinutes": "1440"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "AiSettings": {
    "Provider": "OpenAI",
    "Model": "gpt-4o-mini",
    "SttModel": "whisper-1",
    "TtsModel": "tts-1",
    "TtsVoice": "nova",
    "MaxTokens": 500,
    "Temperature": 0.7,
    "MaxContextMessages": 10,
    "TimeoutSeconds": 30,
    "SttTimeoutSeconds": 25,
    "TtsTimeoutSeconds": 25,
    "MaxAudioSizeBytes": 10485760
  }
}
