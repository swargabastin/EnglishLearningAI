# ==========================================
# AI English Learning App — Environment Template
# ==========================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=EnglishLearningDb
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=EnglishLearningDb;Username=postgres;Password=postgres_secure_password

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001
Cors__AllowedOrigins__0=http://localhost:3000

# JWT Configuration (For Phase 5)
Jwt__Secret=your_very_long_and_secure_jwt_secret_key_minimum_32_characters
Jwt__Issuer=EnglishLearningAI
Jwt__Audience=EnglishLearningAI
Jwt__ExpiryMinutes=60

# External AI Provider Credentials (For Phase 6/7/8)
OpenAI__ApiKey=sk-placeholder-do-not-commit-real-keys
OpenAI__Model=gpt-4o-mini
OpenAI__TtsVoice=alloy

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:5288/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5288/api/v1
